lated buckles for closure.\r\n\r\n\r\n\r\nTwo outer pockets, two deep inner pockets, one of which has a zipper.","material":"Genuine cowhide leather","moq":"50","colors":["Black","Brown","Tan","Custom Colors"],"sizes":["S","M","L","XL","2XL","3XL","4XL"],"tags":[],"images":["https://raw.githubusercontent.com/primecraftpartners/PrimeCraft-Partners-Catalogue/main/Images/PCP-LV-902-1.jpg"],"featured":false}],"fixedCollection":"men-s-vest"}]}]}],["$","section",null,{"className":"relative overflow-hidden bg-ink py-16 text-white","children":[["$","div",null,{"className":"absolute inset-y-0 right-0 hidden w-1/3 bg-[linear-gradient(135deg,rgba(201,149,60,0.28),rgba(138,90,51,0.08))] lg:block"}],["$","div",null,{"className":"container-pad relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between","children":[["$","div",null,{"className":"max-w-2xl","children":[["$","p",null,{"className":"eyebrow mb-3 text-brass","children":"Private Label Manufacturing"}],["$","h2",null,{"className":"text-3xl font-black leading-tight sm:text-5xl","children":"Develop your men's vest line with PrimeCraft Partners"}],["$","p",null,{"className":"mt-4 max-w-xl text-base leading-7 text-white/72","children":"From neck labels and hang tags to custom packaging and production-ready leather apparel, PrimeCraft Partners helps turn your brand into a complete private label line."}]]}],["$","div",null,{"className":"flex flex-col gap-3 sm:flex-col","children":[["$","$L3",null,{"href":"/contact#quote","className":"btn-gold","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":17,"height":17,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-message-square-text","children":[["$","path","1lielz",{"d":"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"}],["$","path","14i4kc",{"d":"M13 8H7"}],["$","path","16if0g",{"d":"M17 12H7"}],"$undefined"]}],"Request Quote"]}